<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Yamori.Core is Windows-only (WMI, performance counters, PawnIO). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Yamori.Helper</RootNamespace>
    <AssemblyName>Yamori.Helper</AssemblyName>
    <!-- x64 only: the RocksDB package ships a native DLL for win-x64 only. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained to match Yamori.App: both run from the same package folder and share its .NET runtime files. -->
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit XML docs; missing public documentation becomes a build warning (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yamori.Core\Yamori.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PawnIO.Modules 0.2.11 (LGPL-2.1): the signed IntelMSR module, unmodified, with its license and source notice. -->
    <None Include="PawnIoModules\IntelMSR.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PawnIoModules\COPYING" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PawnIoModules\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Development only (sc.exe registration); not copied into the package. -->
    <None Include="DevService.ps1" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Debug only: after each build, push changed files to the dev service (YamoriHelperDev) and restart it.
    Does nothing when the dev service is not installed. A failure never breaks the build.
    Set YamoriSkipDevServiceSync=true to turn it off.
  -->
  <Target Name="YamoriSyncDevService"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(YamoriSkipDevServiceSync)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\DevService.ps1&quot; -Action Sync -Configuration $(Configuration)"
          ContinueOnError="WarnAndContinue"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
