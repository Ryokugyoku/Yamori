<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window: the notifier lives in the tray. WinRT (toasts) needs a Windows 10 target. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>Yamori.Notifier</RootNamespace>
    <AssemblyName>Yamori.Notifier</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only, like the rest of the package (RocksDB ships win-x64 only). -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained to match Yamori.App and Yamori.Helper: all three run from the same package folder and share its .NET runtime files. -->
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the LibraryImport source generator (tray icon and window messages). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Emit XML docs; missing public documentation becomes a build warning (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Resources/NotifierStrings.resx is English; ja / es are satellite assemblies. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yamori.Core\Yamori.Core.csproj" />
  </ItemGroup>

</Project>
