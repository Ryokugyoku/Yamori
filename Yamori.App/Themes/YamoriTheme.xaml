<?xml version="1.0" encoding="utf-8"?>
<!--
    Yamori の見た目の共通部品。色は Windows のアクセントカラーと Fluent のテーマの色を使い、ライト／ダークの両方で読みやすくする。
    ブランドの色（ヤモリの緑）は、ヒーローの背景とロゴのまわりだけに使う。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Yamori.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- ヒーロー（画面の一番上の大きな帯）の背景。淡い緑から淡い青へ -->
            <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFDDF3EA" />
                <GradientStop Offset="0.55" Color="#FFE7F1F8" />
                <GradientStop Offset="1" Color="#FFEDEAFB" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="HeroStrokeBrush" Color="#1A0F6E55" />
            <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FF0B7A5C" />
            <!-- アイコンの背景：アクセントカラーを薄く敷く -->
            <SolidColorBrush x:Key="IconBadgeBackgroundBrush" Opacity="0.12" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="SoftChipBackgroundBrush" Color="#B3FFFFFF" />
            <!-- ログイン画面の背景の光 -->
            <RadialGradientBrush x:Key="LoginGlowBrush" Center="0.2,0.1" GradientOrigin="0.2,0.1" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Offset="0" Color="#5530C090" />
                <GradientStop Offset="0.6" Color="#1530A0C0" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </RadialGradientBrush>
            <!-- 分析のグラフ：負荷＝青、温度＝橙、クロック＝紫。異常の区間＝黄（危険は赤） -->
            <SolidColorBrush x:Key="ChartSeries1Brush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="ChartSeries2Brush" Color="#FFC4501A" />
            <SolidColorBrush x:Key="ChartSeries3Brush" Color="#FF7A43B6" />
            <SolidColorBrush x:Key="ChartBandBrush" Color="#38E8A33D" />
            <SolidColorBrush x:Key="ChartCriticalBandBrush" Color="#33D13438" />
            <SolidColorBrush x:Key="ChartBandStrokeBrush" Color="#CCB06A00" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#17000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF123329" />
                <GradientStop Offset="0.55" Color="#FF16283A" />
                <GradientStop Offset="1" Color="#FF221F3D" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="HeroStrokeBrush" Color="#2659D9AE" />
            <SolidColorBrush x:Key="BrandForegroundBrush" Color="#FF5FE0B5" />
            <SolidColorBrush x:Key="IconBadgeBackgroundBrush" Opacity="0.18" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="SoftChipBackgroundBrush" Color="#1FFFFFFF" />
            <RadialGradientBrush x:Key="LoginGlowBrush" Center="0.2,0.1" GradientOrigin="0.2,0.1" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Offset="0" Color="#4030C090" />
                <GradientStop Offset="0.6" Color="#10306090" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="ChartSeries1Brush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="ChartSeries2Brush" Color="#FFFF9A5C" />
            <SolidColorBrush x:Key="ChartSeries3Brush" Color="#FFC29BFF" />
            <SolidColorBrush x:Key="ChartBandBrush" Color="#40F5C04A" />
            <SolidColorBrush x:Key="ChartCriticalBandBrush" Color="#40FF6B6B" />
            <SolidColorBrush x:Key="ChartBandStrokeBrush" Color="#CCF5C04A" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HeroStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BrandForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="IconBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SoftChipBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LoginGlowBrush" Color="Transparent" />
            <!-- ハイコントラストでは系統の色を使い、異常の区間は薄い塗りに加えて枠で示す -->
            <SolidColorBrush x:Key="ChartSeries1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartSeries2Brush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChartSeries3Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartBandBrush" Opacity="0.25" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartCriticalBandBrush" Opacity="0.4" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartBandStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 各画面の内容の幅と余白 -->
    <x:Double x:Key="PageMaxWidth">1240</x:Double>
    <Thickness x:Key="PagePadding">32,20,32,40</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="HeroCornerRadius">16</CornerRadius>

    <!-- 情報をまとめるカード -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- 画面の一番上の大きな帯 -->
    <Style x:Key="HeroStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HeroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HeroStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HeroCornerRadius}" />
        <Setter Property="Padding" Value="28,24" />
    </Style>

    <!-- カードの中の、さらに小さな区切り（センサー 1 つ、仕様 1 項目など） -->
    <Style x:Key="TileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- Windows 11 の設定アプリのような、1 行の設定のカード -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinHeight" Value="68" />
    </Style>

    <!-- カードの左上などに置く、アイコン入りの角丸の四角。アクセントカラーを薄く敷く -->
    <Style x:Key="IconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{ThemeResource IconBadgeBackgroundBrush}" />
    </Style>

    <Style x:Key="IconBadgeGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 小さいアイコンの背景（タイルの見出しなど） -->
    <Style x:Key="SmallIconBadgeStyle" TargetType="Border" BasedOn="{StaticResource IconBadgeStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallIconBadgeGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconBadgeGlyphStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 文字 -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FootnoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 区切りの見出し（「いまの状態」など） -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="2,12,0,0" />
    </Style>

    <!-- 設定のまとまりの見出し -->
    <Style x:Key="SettingsGroupHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,20,0,4" />
    </Style>

    <!-- 大きく見せる数値 -->
    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 中くらいの数値（センサー 1 つのタイルなど） -->
    <Style x:Key="TileValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- タイルの項目名 -->
    <Style x:Key="TileLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 細い棒グラフ -->
    <Style x:Key="SlimBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Maximum" Value="100" />
    </Style>

    <!-- ヒーローの中の、仕様を 1 つ示す小さな札 -->
    <Style x:Key="SpecChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SoftChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- 数字の順位を入れる丸 -->
    <Style x:Key="RankBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{ThemeResource IconBadgeBackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 折れ線と円のグラフの標準の色 -->
    <Style TargetType="controls:Sparkline">
        <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style TargetType="controls:TimeSeriesChart">
        <Setter Property="Series1Brush" Value="{ThemeResource ChartSeries1Brush}" />
        <Setter Property="Series2Brush" Value="{ThemeResource ChartSeries2Brush}" />
        <Setter Property="Series3Brush" Value="{ThemeResource ChartSeries3Brush}" />
        <Setter Property="BandBrush" Value="{ThemeResource ChartBandBrush}" />
        <Setter Property="CriticalBandBrush" Value="{ThemeResource ChartCriticalBandBrush}" />
        <Setter Property="BandStrokeBrush" Value="{ThemeResource ChartBandStrokeBrush}" />
        <Setter Property="GridBrush" Value="{ThemeResource ChartGridBrush}" />
        <Setter Property="AxisTextBrush" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TipBackgroundBrush" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="TipBorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style TargetType="controls:RingGauge">
        <Setter Property="TrackBrush" Value="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
        <Setter Property="ValueBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
</ResourceDictionary>
