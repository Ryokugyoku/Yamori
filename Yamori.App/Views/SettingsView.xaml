<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:views="using:Yamori.Views">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader Title="{l:Loc Key=Nav_Settings}" />

        <!-- アカウント -->
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture
                    Width="56"
                    Height="56"
                    DisplayName="{x:Bind ViewModel.Account.UserName}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Settings_AccountHeader}" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Account.QualifiedName}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_AccountDescription}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 記録の保存先 -->
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}">
                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource IconBadgeGlyphStyle}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Loc Key=Settings_StorageHeader}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_StorageDescription}" />
                    </StackPanel>

                    <RadioButtons
                        IsEnabled="{x:Bind ViewModel.CanChangeStorage, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.StorageIndex, Mode=TwoWay}">
                        <RadioButton>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Loc Key=Settings_StorageLocal}" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Settings_StorageLocalNote}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsEnabled="{x:Bind ViewModel.IsOneDriveAvailable}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Loc Key=Settings_StorageOneDrive}" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.OneDriveNoteText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Loc Key=Settings_StorageCustom}" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.CustomFolderText, Mode=OneWay}" />
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>

                    <Button Command="{x:Bind ViewModel.ChooseFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                            <TextBlock Text="{l:Loc Key=Settings_ChooseFolder}" />
                        </StackPanel>
                    </Button>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsApplying, Mode=OneWay}">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_StorageApplying}" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasFallback, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FallbackText, Mode=OneWay}"
                        Severity="Warning" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasStorageError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.StorageErrorText, Mode=OneWay}"
                        Severity="Error" />

                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource FootnoteTextStyle}"
                        Text="{x:Bind ViewModel.CurrentPathText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 言語 -->
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}">
                    <FontIcon Glyph="&#xE774;" Style="{StaticResource IconBadgeGlyphStyle}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Loc Key=Settings_LanguageHeader}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_LanguageDescription}" />
                </StackPanel>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="220"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Yamori について -->
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadgeStyle}">
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource IconBadgeGlyphStyle}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Loc Key=Settings_AboutHeader}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_AboutDescription}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
