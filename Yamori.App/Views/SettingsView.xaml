<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:views="using:Yamori.Views"
    xmlns:vm="using:Yamori.ViewModels"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!-- Windows 11 の設定アプリにならい、1 行 1 項目のカードをまとまりごとに並べる -->
    <StackPanel
        MaxWidth="1000"
        Padding="{StaticResource PagePadding}"
        Spacing="4">

        <views:PageHeader Margin="0,0,0,12" Title="{l:Loc Key=Nav_Settings}" />

        <!-- アカウント -->
        <Border Padding="20" Style="{StaticResource HeroStyle}">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture
                    Width="64"
                    Height="64"
                    DisplayName="{x:Bind ViewModel.Account.UserName}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource TileLabelTextStyle}" Text="{l:Loc Key=Settings_AccountHeader}" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Text="{x:Bind ViewModel.Account.QualifiedName}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Settings_AccountDescription}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- データと記録 -->
        <TextBlock Style="{StaticResource SettingsGroupHeaderTextStyle}" Text="{l:Loc Key=Settings_GroupData}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE8B7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{l:Loc Key=Settings_RecordingHeader}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Settings_RecordingDescription}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource FootnoteTextStyle}"
                        Text="{x:Bind ViewModel.DataDirectoryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- プライバシー -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{ThemeResource BrandForegroundBrush}"
                    Glyph="&#xE72E;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{l:Loc Key=Settings_PrivacyHeader}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Login_OfflineNote}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 通知（Helper に保存し、通知専用の常駐プログラムと Helper が従う） -->
        <TextBlock Style="{StaticResource SettingsGroupHeaderTextStyle}" Text="{l:Loc Key=Settings_GroupNotifications}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xEA8F;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{l:Loc Key=Settings_NotifyHeader}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Settings_NotifyDescription}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Style="{StaticResource FootnoteTextStyle}"
                        Text="{x:Bind ViewModel.Notifications.StatusText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Notifications.HasStatus, Mode=OneWay}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{l:Loc Key=Settings_NotifyHeader}"
                    IsEnabled="{x:Bind ViewModel.Notifications.IsAvailable, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.Notifications.IsEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Notifications.Kinds}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnomalyKindNotificationOption">
                    <Border Margin="0,4,0,0" Style="{StaticResource SettingsCardStyle}">
                        <Grid Padding="36,0,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind Description}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind Title}"
                                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- しきい値 -->
        <TextBlock Style="{StaticResource SettingsGroupHeaderTextStyle}" Text="{l:Loc Key=Settings_GroupThresholds}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Notifications.Thresholds}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnomalyThresholdOption">
                    <Border Margin="0,0,0,4" Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE9CA;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind Description}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ComboBox
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{l:Loc Key=Settings_ThresholdAutomatic}" />
                                    <ComboBoxItem Content="{l:Loc Key=Settings_ThresholdManual}" />
                                </ComboBox>
                                <NumberBox
                                    Width="110"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                    Maximum="{x:Bind Maximum}"
                                    Minimum="{x:Bind Minimum}"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind Value, Mode=TwoWay}"
                                    Visibility="{x:Bind IsManual, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Unit}"
                                    Visibility="{x:Bind IsManual, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 表示 -->
        <TextBlock Style="{StaticResource SettingsGroupHeaderTextStyle}" Text="{l:Loc Key=Settings_GroupDisplay}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE774;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{l:Loc Key=Settings_LanguageHeader}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{l:Loc Key=Settings_LanguageDescription}" />
                </StackPanel>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Yamori について -->
        <TextBlock Style="{StaticResource SettingsGroupHeaderTextStyle}" Text="{l:Loc Key=Settings_GroupAbout}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Logo/YamoriLogo.png" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=Settings_AboutHeader}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{l:Loc Key=Settings_AboutDescription}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
