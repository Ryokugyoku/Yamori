<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:presentation="using:Yamori.Presentation"
    xmlns:views="using:Yamori.Views">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader
            Description="{l:Loc Key=Apps_Description}"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
            Title="{l:Loc Key=Nav_Apps}" />

        <Border Padding="8" Style="{StaticResource CardStyle}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.TopApps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:AppUsageItem">
                        <Grid Padding="12,10" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ProcessCountText}" />
                            </StackPanel>
                            <ProgressBar
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Value="{x:Bind RelativeShare}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind MemoryText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
