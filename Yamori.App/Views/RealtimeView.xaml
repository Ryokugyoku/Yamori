<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.RealtimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:realtime="using:Yamori.Presentation.Realtime"
    xmlns:sensors="using:Yamori.ViewModels.Sensors"
    xmlns:views="using:Yamori.Views"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader Description="{l:Loc Key=Realtime_Description}" Title="{l:Loc Key=Nav_Realtime}" />

        <!-- Helper との接続と拡張センサー（PawnIO）の状態は、ここ 1 か所にまとめて表示する -->
        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.Tree.NoticeText, Mode=OneWay}"
            Severity="{x:Bind ViewModel.Tree.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.Tree.NoticeTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    Click="OnConsentClick"
                    Content="{x:Bind ViewModel.Tree.ConsentActionText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Tree.CanChangeConsent, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 詳細：ハードウェア → グループ → センサー。カタログから自動で組み立てる -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tree.Hardware}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sensors:SensorHardwareItem">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <Grid Padding="0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource IconBadgeGlyphStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind KindName, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <ItemsRepeater ItemsSource="{x:Bind Groups}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sensors:SensorGroupItem">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                        <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout
                                                    ItemsStretch="Fill"
                                                    MinColumnSpacing="24"
                                                    MinItemWidth="300"
                                                    MinRowSpacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="sensors:SensorRowItem">
                                                    <StackPanel Opacity="{x:Bind Opacity, Mode=OneWay}" Spacing="2">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Style="{StaticResource SecondaryTextStyle}"
                                                                Text="{x:Bind Label, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"
                                                                ToolTipService.ToolTip="{x:Bind Key}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                IsTextSelectionEnabled="True"
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind ValueText, Mode=OneWay}" />
                                                        </Grid>
                                                        <ProgressBar
                                                            Maximum="100"
                                                            Value="{x:Bind Percent, Mode=OneWay}"
                                                            Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Expander>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- アプリごとの今の使用量（センサーではないため、従来の測定のまま） -->
        <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.Apps.StatusText, Mode=OneWay}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps.Sections}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="16" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="realtime:RealtimeSection">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource IconBadgeGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="16">
                                <!-- 見出し：種類の名前と、いちばん大事な値 -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Category, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Headline, Mode=OneWay}" />
                                    </Grid>
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{x:Bind HeadlinePercent, Mode=OneWay}"
                                        Visibility="{x:Bind HasHeadlinePercent, Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="{x:Bind Note, Mode=OneWay}"
                                        Visibility="{x:Bind HasNote, Mode=OneWay}" />
                                </StackPanel>

                                <!-- この種類に属する部品（GPU 1 枚、ディスク 1 台など） -->
                                <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="20" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="realtime:RealtimeEntry">
                                            <StackPanel Spacing="8">
                                                <StackPanel Spacing="0">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource SecondaryTextStyle}"
                                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                                        Visibility="{x:Bind HasSubtitle, Mode=OneWay}" />
                                                </StackPanel>

                                                <!-- 項目名と値の組。幅に合わせて複数列に並べる -->
                                                <ItemsRepeater ItemsSource="{x:Bind Facts}">
                                                    <ItemsRepeater.Layout>
                                                        <UniformGridLayout
                                                            ItemsStretch="Fill"
                                                            MinColumnSpacing="24"
                                                            MinItemWidth="300"
                                                            MinRowSpacing="6" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="realtime:RealtimeFact">
                                                            <StackPanel Spacing="2">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Style="{StaticResource SecondaryTextStyle}"
                                                                        Text="{x:Bind Label, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        TextWrapping="NoWrap"
                                                                        ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        IsTextSelectionEnabled="True"
                                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                                        Text="{x:Bind Value, Mode=OneWay}" />
                                                                </Grid>
                                                                <ProgressBar
                                                                    Maximum="100"
                                                                    Value="{x:Bind Percent, Mode=OneWay}"
                                                                    Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
