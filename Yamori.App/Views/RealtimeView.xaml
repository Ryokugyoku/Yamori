<?xml version="1.0" encoding="utf-8"?>
<!--
    リアルタイム画面。左の一覧でハードウェア（またはアプリ）を 1 つ選び、右にそれだけを詳しく表示する。
    左の一覧は固定し、右の詳細だけをスクロールする（ISelfScrollingPage）。
-->
<UserControl
    x:Class="Yamori.Views.RealtimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Yamori.Controls"
    xmlns:l="using:Yamori.Localization"
    xmlns:realtime="using:Yamori.Presentation.Realtime"
    xmlns:sensors="using:Yamori.ViewModels.Sensors"
    xmlns:views="using:Yamori.Views"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <UserControl.Resources>
        <!-- 左の一覧の 1 行。選んだ行が分かるよう、Fluent の標準の選択の表示を使う -->
        <Style x:Key="MasterItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 名前と値を 1 行ずつ並べるときの、センサー 1 つ -->
        <DataTemplate x:Key="SensorListRowTemplate" x:DataType="sensors:SensorRowItem">
            <Border
                Padding="14,10"
                Opacity="{x:Bind Opacity, Mode=OneWay}"
                Style="{StaticResource TileStyle}">
                <Grid ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Label, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind FullLabel, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource TileValueTextStyle}"
                        FontSize="16"
                        Text="{x:Bind ValueText, Mode=OneWay}" />
                    <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource SlimBarStyle}"
                        Value="{x:Bind Percent, Mode=OneWay}"
                        Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 数が多いときの、センサー 1 つの小さなマス（スレッドごとの値など） -->
        <DataTemplate x:Key="SensorDenseCellTemplate" x:DataType="sensors:SensorRowItem">
            <Border
                Padding="10,8"
                Opacity="{x:Bind Opacity, Mode=OneWay}"
                Style="{StaticResource TileStyle}"
                ToolTipService.ToolTip="{x:Bind FullLabel, Mode=OneWay}">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource TileLabelTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource TileValueTextStyle}"
                        FontSize="15"
                        Text="{x:Bind ValueText, Mode=OneWay}" />
                    <ProgressBar
                        Margin="0,2,0,0"
                        Style="{StaticResource SlimBarStyle}"
                        Value="{x:Bind Percent, Mode=OneWay}"
                        Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        MaxWidth="1600"
        Padding="32,20,32,0"
        RowSpacing="16">

        <VisualStateManager.VisualStateGroups>
            <!-- 狭い窓では左の一覧を細くする -->
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MasterColumn.Width" Value="220" />
                        <Setter Target="Root.Padding" Value="16,12,16,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと、最後に測った時刻 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:PageHeader Description="{l:Loc Key=Realtime_Description}" Title="{l:Loc Key=Nav_Realtime}" />
            <Border
                Grid.Column="1"
                Padding="12,6"
                VerticalAlignment="Top"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Apps.StatusText, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Helper との接続と拡張センサー（PawnIO）の状態は、ここ 1 か所にまとめて表示する -->
        <InfoBar
            Grid.Row="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.Tree.NoticeText, Mode=OneWay}"
            Severity="{x:Bind ViewModel.Tree.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.Tree.NoticeTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <!-- Helper が動いていなければサービスの起動、つながっていれば PawnIO の利用の同意のボタン -->
                <Button
                    Click="OnNoticeActionClick"
                    Content="{x:Bind ViewModel.Tree.NoticeActionText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Tree.IsNoticeActionEnabled, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Tree.HasNoticeAction, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MasterColumn" Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：ハードウェアとアプリの一覧。主な値を 1 つずつ添えて、選ぶ前でも様子が分かるようにする -->
            <Border
                Margin="0,0,0,20"
                Padding="6"
                VerticalAlignment="Stretch"
                Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="12,8,0,2"
                            Style="{StaticResource TileLabelTextStyle}"
                            Text="{l:Loc Key=Nav_Hardware}" />
                        <ListView
                            x:Name="HardwareList"
                            ItemContainerStyle="{StaticResource MasterItemStyle}"
                            ItemsSource="{x:Bind ViewModel.Tree.Hardware}"
                            SelectionChanged="OnHardwareSelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="sensors:SensorHardwareItem">
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource SmallIconBadgeStyle}">
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind KindName, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Style="{StaticResource FootnoteTextStyle}"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind HeadlineText, Mode=OneWay}" />
                                        <ProgressBar
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource SlimBarStyle}"
                                            Value="{x:Bind HeadlinePercent, Mode=OneWay}"
                                            Visibility="{x:Bind HasHeadlinePercent, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Margin="12,12,0,2"
                            Style="{StaticResource TileLabelTextStyle}"
                            Text="{l:Loc Key=Nav_Apps}" />
                        <ListView
                            x:Name="AppsList"
                            ItemContainerStyle="{StaticResource MasterItemStyle}"
                            SelectionChanged="OnAppsSelectionChanged"
                            SelectionMode="Single">
                            <ListViewItem AutomationProperties.Name="{l:Loc Key=Rt_Section_Apps}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SmallIconBadgeStyle}">
                                        <FontIcon Glyph="&#xE71D;" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=Rt_Section_Apps}" />
                                        <TextBlock
                                            Style="{StaticResource FootnoteTextStyle}"
                                            Text="{l:Loc Key=Rt_Apps_ByCpu}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右：選んだものの詳細 -->
            <ScrollViewer Grid.Column="1" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,0,24">

                    <!-- ハードウェアの詳細 -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowsHardware, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border VerticalAlignment="Center" Style="{StaticResource IconBadgeStyle}">
                                <FontIcon Glyph="{x:Bind ViewModel.SelectedHardware.Glyph, Mode=OneWay, FallbackValue=''}" Style="{StaticResource IconBadgeGlyphStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Style="{StaticResource TileLabelTextStyle}" Text="{x:Bind ViewModel.SelectedHardware.KindName, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    FontSize="20"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.SelectedHardware.Title, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- 主な値：大きな数字と、直近 1 分の動き -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedHardware.Highlights, Mode=OneWay, FallbackValue={x:Null}}" Visibility="{x:Bind ViewModel.SelectedHardware.HasHighlights, Mode=OneWay, FallbackValue=Collapsed}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="4"
                                    MinColumnSpacing="12"
                                    MinItemWidth="200"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sensors:SummaryCardItem">
                                    <Border
                                        Padding="18,14,18,12"
                                        Opacity="{x:Bind Opacity, Mode=OneWay}"
                                        Style="{StaticResource CardStyle}">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                                            <Grid Grid.Row="1" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource MetricValueTextStyle}"
                                                    FontSize="26"
                                                    Text="{x:Bind ValueText, Mode=OneWay}" />
                                                <controls:RingGauge
                                                    Grid.Column="1"
                                                    Width="38"
                                                    Height="38"
                                                    RingThickness="5"
                                                    Value="{x:Bind Percent, Mode=OneWay}"
                                                    Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                                            </Grid>
                                            <controls:Sparkline
                                                Grid.Row="2"
                                                Maximum="{x:Bind TrendMaximum, Mode=OneWay}"
                                                Minimum="{x:Bind TrendMinimum, Mode=OneWay}"
                                                Values="{x:Bind Trend, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Style="{StaticResource FootnoteTextStyle}"
                                                Text="{x:Bind Source, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTipService.ToolTip="{x:Bind Source, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- すべての値：グループごとに 1 枚のカード -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedHardware.Groups, Mode=OneWay, FallbackValue={x:Null}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sensors:SensorGroupItem">
                                    <Border Padding="16" Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    FontSize="15"
                                                    Text="{x:Bind Title, Mode=OneWay}" />
                                                <Border
                                                    Padding="8,1"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource IconBadgeBackgroundBrush}"
                                                    CornerRadius="9">
                                                    <TextBlock
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind CountText, Mode=OneWay}" />
                                                </Border>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource FootnoteTextStyle}"
                                                    Text="{x:Bind Note, Mode=OneWay}"
                                                    Visibility="{x:Bind HasNote, Mode=OneWay}" />
                                            </StackPanel>

                                            <ItemsRepeater
                                                ItemTemplate="{StaticResource SensorListRowTemplate}"
                                                ItemsSource="{x:Bind Rows}"
                                                Visibility="{x:Bind IsList, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout
                                                        ItemsStretch="Fill"
                                                        MinColumnSpacing="8"
                                                        MinItemWidth="280"
                                                        MinRowSpacing="8" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                            <ItemsRepeater
                                                ItemTemplate="{StaticResource SensorDenseCellTemplate}"
                                                ItemsSource="{x:Bind Rows}"
                                                Visibility="{x:Bind IsDense, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout
                                                        ItemsStretch="Fill"
                                                        MinColumnSpacing="6"
                                                        MinItemWidth="104"
                                                        MinRowSpacing="6" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- アプリの詳細：CPU・GPU・読み書きのそれぞれで多い順 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps.Sections}" Visibility="{x:Bind ViewModel.IsAppsSelected, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="realtime:RealtimeSection">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border VerticalAlignment="Center" Style="{StaticResource IconBadgeStyle}">
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource IconBadgeGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Style="{StaticResource TileLabelTextStyle}" Text="{x:Bind Category, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                FontSize="20"
                                                Text="{x:Bind Headline, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                ItemsStretch="Fill"
                                                MaximumRowsOrColumns="3"
                                                MinColumnSpacing="12"
                                                MinItemWidth="300"
                                                MinRowSpacing="12" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="realtime:RealtimeEntry">
                                                <Border Padding="16" VerticalAlignment="Stretch" Style="{StaticResource CardStyle}">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            FontSize="15"
                                                            Text="{x:Bind Title, Mode=OneWay}" />
                                                        <TextBlock
                                                            Style="{StaticResource FootnoteTextStyle}"
                                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                                            Visibility="{x:Bind HasSubtitle, Mode=OneWay}" />
                                                        <!--
                                                            3 枚のカードは並べ方（UniformGridLayout）の都合で同じ高さになるため、行の高さを一定にし、
                                                            上位 5 件ぶんの高さを確保する（中身の多いカードが下で切れないように）
                                                        -->
                                                        <ItemsRepeater MinHeight="248" ItemsSource="{x:Bind Facts}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Spacing="12" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="realtime:RealtimeFact">
                                                                    <Grid Height="40" ColumnSpacing="12" RowSpacing="4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock
                                                                            Text="{x:Bind Label, Mode=OneWay}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap"
                                                                            ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            IsTextSelectionEnabled="True"
                                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                            Text="{x:Bind Value, Mode=OneWay}"
                                                                            TextWrapping="NoWrap" />
                                                                        <ProgressBar
                                                                            Grid.Row="1"
                                                                            Grid.ColumnSpan="2"
                                                                            Style="{StaticResource SlimBarStyle}"
                                                                            Value="{x:Bind Percent, Mode=OneWay}"
                                                                            Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Grid.ColumnSpan="2"
                                                                            Style="{StaticResource FootnoteTextStyle}"
                                                                            Text="{x:Bind Detail, Mode=OneWay}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap"
                                                                            ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}"
                                                                            Visibility="{x:Bind HasDetail, Mode=OneWay}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <TextBlock
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="{x:Bind Note, Mode=OneWay}"
                                        Visibility="{x:Bind HasNote, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
