<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization">

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description, Mode=OneWay}" />
        </StackPanel>
        <ProgressRing
            Grid.Column="1"
            Width="20"
            Height="20"
            IsActive="{x:Bind IsBusy, Mode=OneWay}" />
        <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            Command="{x:Bind RefreshCommand, Mode=OneWay}"
            Visibility="{x:Bind ShowsRefresh, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                <TextBlock Text="{l:Loc Key=Common_Refresh}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
