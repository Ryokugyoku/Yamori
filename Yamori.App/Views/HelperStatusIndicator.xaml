<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.HelperStatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Yamori.Controls"
    xmlns:l="using:Yamori.Localization">

    <!-- タイトルバーの右側の札。押すと、詳しい状態とサービスの起動ボタンを出す -->
    <Button
        x:Name="StatusButton"
        Padding="2"
        VerticalAlignment="Center"
        AutomationProperties.Name="{x:Bind ViewModel.Label, Mode=OneWay}"
        Background="Transparent"
        BorderThickness="0"
        ToolTipService.ToolTip="{x:Bind ViewModel.Detail, Mode=OneWay}">
        <controls:StatusChip Level="{x:Bind ViewModel.Level, Mode=OneWay}" Text="{x:Bind ViewModel.Label, Mode=OneWay}" />
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MaxWidth="340" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource IconBadgeStyle}">
                            <FontIcon Glyph="&#xE83D;" Style="{StaticResource IconBadgeGlyphStyle}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=Helper_Title}" />
                            <controls:StatusChip Level="{x:Bind ViewModel.Level, Mode=OneWay}" Text="{x:Bind ViewModel.Label, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" />
                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasExtendedText, Mode=OneWay}">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind ViewModel.ExtendedTitle}" />
                        <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.ExtendedText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnStartClick"
                        IsEnabled="{x:Bind ViewModel.IsStartEnabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="{x:Bind ViewModel.StartText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="ErrorText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
