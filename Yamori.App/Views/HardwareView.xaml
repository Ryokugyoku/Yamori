<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:presentation="using:Yamori.Presentation"
    xmlns:views="using:Yamori.Views">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader
            Description="{l:Loc Key=Hardware_Description}"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
            Title="{l:Loc Key=Nav_Hardware}" />

        <!-- 部品ごとのカードを、幅に合わせて並べる -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hardware}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MinColumnSpacing="16"
                    MinItemHeight="120"
                    MinItemWidth="320"
                    MinRowSpacing="16" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="presentation:HardwareRow">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconBadgeGlyphStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind Category}" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
