<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:hardware="using:Yamori.Presentation.Hardware"
    xmlns:views="using:Yamori.Views">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader
            Description="{l:Loc Key=Hardware_Description}"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
            Title="{l:Loc Key=Nav_Hardware}" />

        <!-- 部品の種類（CPU、マザーボード、メモリ…）ごとに 1 枚のカード -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hardware}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="16" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="hardware:HardwareSection">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconBadgeGlyphStyle}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Category}" />
                                    <TextBlock
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="{x:Bind Note}"
                                        Visibility="{x:Bind HasNote}" />
                                </StackPanel>

                                <!-- この種類に属する部品（GPU 2 枚、メモリ 4 枚など） -->
                                <ItemsRepeater ItemsSource="{x:Bind Entries}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="16" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="hardware:HardwareEntry">
                                            <StackPanel Spacing="6">
                                                <StackPanel Spacing="0">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource SecondaryTextStyle}"
                                                        Text="{x:Bind Subtitle}"
                                                        Visibility="{x:Bind HasSubtitle}" />
                                                </StackPanel>

                                                <!-- 項目名と値の組 -->
                                                <ItemsRepeater ItemsSource="{x:Bind Facts}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="hardware:HardwareFact">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="160" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    IsTextSelectionEnabled="True"
                                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                                    Text="{x:Bind Value}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
