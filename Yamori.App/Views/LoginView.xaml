<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization">

    <Grid Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border
                MaxWidth="440"
                Margin="0,24"
                Padding="40,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="24">

                    <!-- アプリ名 -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <Border
                            Width="64"
                            Height="64"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            CornerRadius="16"
                            Style="{StaticResource IconBadgeStyle}">
                            <FontIcon
                                FontSize="30"
                                Glyph="&#xEA18;"
                                Style="{StaticResource IconBadgeGlyphStyle}" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{l:Loc Key=Login_Title}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{l:Loc Key=App_Tagline}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <!-- サインインするアカウント -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <PersonPicture
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center"
                            DisplayName="{x:Bind ViewModel.Account.UserName}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Account.UserName}"
                            TextAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource FootnoteTextStyle}"
                            Text="{x:Bind ViewModel.Account.QualifiedName}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{l:Loc Key=Login_Subtitle}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="SignInButton"
                            MinHeight="40"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.SignInCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Glyph="&#xE8D7;" />
                                <TextBlock Text="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Grid MinHeight="20" ColumnSpacing="8" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                TextAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            MaxWidth="320"
                            Style="{StaticResource FootnoteTextStyle}"
                            Text="{l:Loc Key=Login_OfflineNote}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
