<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Yamori.Localization"
    xmlns:presentation="using:Yamori.Presentation"
    xmlns:views="using:Yamori.Views">

    <StackPanel
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <views:PageHeader
            Description="{l:Loc Key=App_Tagline}"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
            Title="{l:Loc Key=Nav_Overview}" />

        <!-- 今の使用率 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource IconBadgeStyle}">
                        <FontIcon Glyph="&#xE950;" Style="{StaticResource IconBadgeGlyphStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Overview_CpuNow}" />
                        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Maximum="100"
                        Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource IconBadgeStyle}">
                        <FontIcon Glyph="&#xEEA0;" Style="{StaticResource IconBadgeGlyphStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Overview_MemoryNow}" />
                        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Maximum="100"
                        Value="{x:Bind ViewModel.MemoryUsage, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 次の PC の基準 -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Loc Key=Overview_NextPcTitle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Overview_NextPcDescription}" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:RecommendationItem">
                            <Border
                                Padding="16"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconBadgeGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Explanation}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- データの扱い -->
        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.PrivacyNoteText, Mode=OneWay}" />
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{StaticResource FootnoteTextStyle}"
                Text="{x:Bind ViewModel.DataDirectoryText, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
