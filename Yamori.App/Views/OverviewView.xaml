<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Yamori.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:analysis="using:Yamori.Presentation.Analysis"
    xmlns:controls="using:Yamori.Controls"
    xmlns:l="using:Yamori.Localization"
    xmlns:presentation="using:Yamori.Presentation"
    xmlns:sensors="using:Yamori.ViewModels.Sensors">

    <StackPanel
        x:Name="Root"
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        Spacing="16">

        <VisualStateManager.VisualStateGroups>
            <!-- 広い画面では「次の PC の基準」と「アプリ」を左右に並べ、狭い画面では縦に並べる -->
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppsColumn.Width" Value="*" />
                        <Setter Target="InsightsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="AppsCard.(Grid.Row)" Value="0" />
                        <Setter Target="AppsCard.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ヒーロー：あいさつ、見守りの状態、この PC の主な仕様 -->
        <Border Style="{StaticResource HeroStyle}">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource BrandForegroundBrush}"
                                Glyph="&#xE83D;" />
                            <TextBlock
                                Foreground="{ThemeResource BrandForegroundBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.WatchingText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=App_Tagline}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressRing
                            Width="18"
                            Height="18"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="{l:Loc Key=Common_Refresh}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="{l:Loc Key=Common_Refresh}">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Specs}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="10"
                            MinItemWidth="230"
                            MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="presentation:SpecItem">
                            <Border Style="{StaticResource SpecChipStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SmallIconBadgeStyle}">
                                        <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Style="{StaticResource TileLabelTextStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind Value}" />
                                        <TextBlock
                                            Style="{StaticResource FootnoteTextStyle}"
                                            Text="{x:Bind Detail}"
                                            Visibility="{x:Bind HasDetail}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>

        <!-- いまの状態：カードごとに候補のキーから使えるものを表示する。候補が 1 つもないカードは出さない -->
        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{l:Loc Key=Overview_LiveHeader}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SummaryCards.Cards}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MinColumnSpacing="12"
                    MinItemWidth="250"
                    MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sensors:SummaryCardItem">
                    <Border
                        Padding="18,16,18,12"
                        Opacity="{x:Bind Opacity, Mode=OneWay}"
                        Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!-- 円のグラフの有無でタイルの高さが変わらないよう、値の行の高さをそろえる -->
                                <RowDefinition Height="48" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 見出し -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource SmallIconBadgeStyle}">
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                            </StackPanel>

                            <!-- 値と、割合なら円のグラフ -->
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource MetricValueTextStyle}"
                                    Text="{x:Bind ValueText, Mode=OneWay}" />
                                <controls:RingGauge
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    RingThickness="5"
                                    Value="{x:Bind Percent, Mode=OneWay}"
                                    Visibility="{x:Bind HasPercent, Mode=OneWay}" />
                            </Grid>

                            <!-- 直近 1 分の動き -->
                            <controls:Sparkline
                                Grid.Row="2"
                                Maximum="{x:Bind TrendMaximum, Mode=OneWay}"
                                Minimum="{x:Bind TrendMinimum, Mode=OneWay}"
                                Values="{x:Bind Trend, Mode=OneWay}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource FootnoteTextStyle}"
                                Text="{x:Bind Source, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Source, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- 最近の異常：分析画面への入口。押すとその異常を選んだ状態で分析画面を開く -->
        <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SmallIconBadgeStyle}">
                        <FontIcon Glyph="&#xE7BA;" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontSize="18"
                            Text="{l:Loc Key=Overview_AnomaliesHeader}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind RecentAnomalies.SummaryText, Mode=OneWay}" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnOpenAnalysisClick"
                        Content="{l:Loc Key=Overview_OpenAnalysis}" />
                </Grid>
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="OnRecentAnomalyClick"
                    ItemsSource="{x:Bind RecentAnomalies.Items}"
                    SelectionMode="None"
                    Visibility="{x:Bind RecentAnomalies.HasItems, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="analysis:AnomalyItem">
                            <Grid AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:StatusChip
                                    MinWidth="72"
                                    Level="{x:Bind Level}"
                                    Text="{x:Bind SeverityText}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="{x:Bind PartText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind TimeText}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource FootnoteTextStyle}"
                                        Text="{x:Bind DurationText}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- 次の PC の基準と、メモリを多く使っているアプリ -->
        <Grid
            x:Name="InsightsGrid"
            Margin="0,12,0,0"
            RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition x:Name="AppsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border VerticalAlignment="Stretch" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SmallIconBadgeStyle}">
                                <FontIcon Glyph="&#xE9D2;" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                FontSize="18"
                                Text="{l:Loc Key=Overview_NextPcTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=Overview_NextPcDescription}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:RecommendationItem">
                                <Border Padding="16,14" Style="{StaticResource TileStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadgeStyle}">
                                            <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconBadgeGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <controls:StatusChip
                                                Level="{x:Bind Level}"
                                                Text="{x:Bind LevelText}"
                                                Visibility="{x:Bind HasLevel}" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Explanation}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind SourceText}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasSourceText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border
                x:Name="AppsCard"
                Grid.Row="1"
                VerticalAlignment="Stretch"
                Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource SmallIconBadgeStyle}">
                            <FontIcon Glyph="&#xE71D;" Style="{StaticResource SmallIconBadgeGlyphStyle}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontSize="18"
                            Text="{l:Loc Key=Overview_TopAppsHeader}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopAppsPreview}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:AppUsageItem">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind MemoryText}" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource SlimBarStyle}" Value="{x:Bind RelativeShare}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- データの扱い -->
        <Border
            Margin="0,8,0,0"
            Padding="16,12"
            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    FontSize="16"
                    Foreground="{ThemeResource BrandForegroundBrush}"
                    Glyph="&#xE72E;" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PrivacyNoteText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource FootnoteTextStyle}"
                        Text="{x:Bind ViewModel.DataDirectoryText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
