<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Packaged services (desktop6:Service, the Helper) need Windows 10 1903 or later. -->
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>Yamori</RootNamespace>
    <AssemblyName>Yamori</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Logo\Yamori.ico</ApplicationIcon>
    <!-- x64 only for now: the RocksDB package (time-series store) ships a native DLL for win-x64 only. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Localization/Resources/UiStrings.resx is English; ja / es are satellite assemblies. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-16_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- ロゴの原本（SVG）と、画面・ウィンドウで使う書き出し。 -->
    <None Include="Assets\Logo\YamoriLogo.svg" />
    <!-- パッケージ化しない起動（Unpackaged）でも読めるよう、出力フォルダーにもコピーする。 -->
    <Content Include="Assets\Logo\YamoriLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo\Yamori.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yamori.Core\Yamori.Core.csproj" />
    <!-- The Helper (Windows service) ships inside this MSIX; its exe, runtimeconfig, deps and PawnIO module are copied next to Yamori.exe. -->
    <ProjectReference Include="..\Yamori.Helper\Yamori.Helper.csproj" />
    <!-- The notifier (tray + Windows notifications, started at sign-in) also ships inside this MSIX next to Yamori.exe. -->
    <ProjectReference Include="..\Yamori.Notifier\Yamori.Notifier.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Debug builds leave out the packaged service (the parts of Package.appxmanifest between
    "release-only:begin" and "release-only:end"), so Visual Studio can deploy without administrator
    rights and never has to overwrite a running Yamori.Helper.exe. During development the Helper runs
    as a sc.exe service from a copy (Yamori.Helper\DevService.ps1). Release builds use Package.appxmanifest as is.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <YamoriDebugAppxManifest>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)Package.Debug.appxmanifest</YamoriDebugAppxManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AppxManifest Include="$(YamoriDebugAppxManifest)">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Package.appxmanifest" />
  </ItemGroup>
  <Target Name="YamoriWriteDebugAppxManifest"
          Condition="'$(Configuration)' == 'Debug'"
          BeforeTargets="PrepareForBuild;_ValidatePresenceOfAppxManifestItems"
          Inputs="$(MSBuildProjectDirectory)\Package.appxmanifest"
          Outputs="$(YamoriDebugAppxManifest)">
    <PropertyGroup>
      <_YamoriManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Package.appxmanifest'))</_YamoriManifestText>
      <_YamoriManifestText>$([System.Text.RegularExpressions.Regex]::Replace('$(_YamoriManifestText)', '(?s)[ \t]*&lt;!-- release-only:begin.*?release-only:end --&gt;\r?\n', ''))</_YamoriManifestText>
    </PropertyGroup>
    <WriteLinesToFile File="$(YamoriDebugAppxManifest)" Lines="$([MSBuild]::Escape($(_YamoriManifestText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming disabled: WinUI/WMI/reflection-heavy code is not trim-safe yet. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>